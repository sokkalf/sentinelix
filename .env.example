# Copy to .env and adjust. See README.md ("Configuration") for all variables.

# Required. Generate SECRET_KEY_BASE with `openssl rand -base64 48` (or
# `mix phx.gen.secret`); POSTGRES_PASSWORD is the bundled Postgres' password.
SECRET_KEY_BASE=
POSTGRES_PASSWORD=

# Public URL. For the quick start on http://localhost:4000; behind a TLS
# terminating reverse proxy set PHX_HOST to your domain and remove
# PHX_SCHEME/PHX_URL_PORT (defaults: https, 443).
PHX_HOST=localhost
PHX_SCHEME=http
PHX_URL_PORT=4000
# Host port the app is published on (docker-compose.yml)
# SENTINELIX_PORT=4000

# First local admin, created on boot if it doesn't exist (password: 12-72
# characters)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# OpenID Connect (optional)
# OIDC_ISSUER=https://auth.example.com/application/o/sentinelix/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=Authentik
# OIDC_ALLOWED_GROUPS=sentinelix-admins
# LOCAL_AUTH_ENABLED=false

# Email notifications (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS=starttls
# NOTIFICATIONS_EMAIL_FROM=Sentinelix <alerts@example.com>

# Reverse proxy: trust its X-Forwarded-For header (rate limiting, logs)
# TRUSTED_PROXIES=172.16.0.0/12

# Prometheus /metrics (disabled while unset)
# METRICS_TOKEN=

# DEFAULT_TIMEZONE=Europe/Oslo
# RETENTION_DAYS=90
# ROLLUP_RETENTION_DAYS=365
